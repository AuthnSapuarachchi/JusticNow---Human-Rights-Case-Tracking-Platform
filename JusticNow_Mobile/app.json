{
  "expo": {
    "name": "JusticeNow",
    "slug": "JusticeNow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/justiceNow-favicon.png",
    "scheme": "justicnow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/justiceNow-favicon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/justiceNow-favicon.png",
        "backgroundImage": "./assets/images/justiceNow-favicon.png",
        "monochromeImage": "./assets/images/justiceNow-favicon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.JusticNow"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/justiceNow-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/justiceNow-favicon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
