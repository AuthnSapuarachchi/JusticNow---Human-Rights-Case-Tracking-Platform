// --- 1. ADMINISTRATIVE TABLES ---
model User {
  id             Int                @id @default(autoincrement())
  email          String             @unique
  password       String
  name           String?
  role           Role               @default(OFFICER)
  
  organizationId Int?
  organization   LegalOrganization? @relation(fields: [organizationId], references: [id])
  officerCases   Case[]            @relation("CaseOfficer")
  
  officerMessages Message[]         @relation("MessageOfficer")
  sentMessages    Message[]         @relation("MessageSender")
  receivedMessages Message[]        @relation("MessageRecipient")
  
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("user")
}

model LegalOrganization {
  id           Int      @id @default(autoincrement())
  name         String
  contactEmail String
  verified     Boolean  @default(false)
  
  officers     User[]   
  
  createdAt    DateTime @default(now())

  @@map("legalorganization")
}

// --- 2. CITIZEN & REPORTING TABLES ---
