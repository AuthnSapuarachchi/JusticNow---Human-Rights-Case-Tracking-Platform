generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}


// ==============================
// ENUMS
// ==============================

enum Role {
  CITIZEN
  OFFICER
  ADMIN
}


// CHANGED:
// Expanded statuses to support both
// Citizen Tracking Dashboard + Officer Workflow
enum CaseStatus {

  SUBMITTED

  UNDER_REVIEW

  ADDITIONAL_INFORMATION_REQUIRED

  ASSIGNED_TO_OFFICER

  INVESTIGATION_IN_PROGRESS

  REFERRED_FOR_LEGAL_SUPPORT

  RESOLUTION_PROPOSED

  RESOLVED

  CLOSED

  REJECTED
}


// TAKEN FROM INCOMING CHANGES
// Used by citizen reporting component
enum ViolationCategory {

  WORKPLACE_DISCRIMINATION

  HUMAN_RIGHTS_VIOLATION

  DIGITAL_PRIVACY

  OTHER
}



// ==============================
// 1. ADMINISTRATIVE TABLES
// ==============================


model User {

  id             Int      @id @default(autoincrement())

  email          String   @unique

  password       String

  name           String?

  role           Role     @default(OFFICER)



  organizationId Int?

  organization   LegalOrganization?
    @relation(fields:[organizationId], references:[id])



  // Existing message relationship
  messages       Message[]



  // NEW:
  // Allows officer dashboard
  // to retrieve assigned cases
  assignedCases  Case[]



  // NEW:
  // Officer notes created
  notes          CaseNote[]



  createdAt      DateTime @default(now())

  updatedAt      DateTime @updatedAt



  @@map("users")
}



model LegalOrganization {

  id           Int      @id @default(autoincrement())

  name         String

  contactEmail String

  verified     Boolean  @default(false)



  officers     User[]



  createdAt    DateTime @default(now())



  @@map("legal_organizations")
}



// ==============================
// 2. CITIZEN & REPORTING TABLES
// ==============================


model Case {


  id             Int               @id @default(autoincrement())


  description    String            @db.Text



  // CHANGED:
  // Expanded CaseStatus enum
  status         CaseStatus        @default(SUBMITTED)



  // TAKEN FROM INCOMING CHANGES
  // Supports citizen dashboard
  isAnonymous    Boolean           @default(true)

  category       ViolationCategory @default(OTHER)

  incidentDate   DateTime?

  location       String?

  actionRequest  String?



  // ==========================
  // NEW OFFICER MANAGEMENT PART
  // ==========================


  // NEW:
  // Connects a case to an assigned officer
  // Required for officer dashboard
  officerId      Int?


  officer        User?
    @relation(
      fields:[officerId],
      references:[id]
    )



  // ==========================



  trackingCode   TrackingCode?



  evidence       Evidence[]



  messages       Message[]



  // NEW:
  // Stores case timeline
  statusHistory  CaseHistory[]



  // NEW:
  // Stores officer private notes
  notes          CaseNote[]



  createdAt      DateTime @default(now())

  updatedAt      DateTime @updatedAt



  @@map("cases")
}





model TrackingCode {

  id     Int    @id @default(autoincrement())


  code   String @unique


  pin    String



  caseId Int @unique


  case   Case
    @relation(
      fields:[caseId],
      references:[id],
      onDelete:Cascade
    )



  @@map("tracking_codes")
}





model Evidence {


  id        Int      @id @default(autoincrement())


  fileUrl   String


  fileType  String



  // TAKEN FROM INCOMING CHANGES
  fileName  String?


  fileSize  String?



  caseId    Int


  case      Case
    @relation(
      fields:[caseId],
      references:[id],
      onDelete:Cascade
    )



  createdAt DateTime @default(now())


  @@map("evidence_items")
}





// ==============================
// 3. MESSAGING
// ==============================


model Message {

  id         Int      @id @default(autoincrement())

  content    String   @db.Text

  isFromUser Boolean


  caseId     Int

  case       Case
    @relation(
      fields:[caseId],
      references:[id],
      onDelete:Cascade
    )


  officerId Int?

  officer User?
    @relation(
      fields:[officerId],
      references:[id]
    )


  createdAt DateTime @default(now())


  @@map("messages")
}



// ==============================
// NEW: CASE TIMELINE
// ==============================


model CaseHistory {


  id Int @id @default(autoincrement())



  caseId Int


  case Case
    @relation(
      fields:[caseId],
      references:[id],
      onDelete:Cascade
    )



  previousStatus CaseStatus?



  newStatus CaseStatus



  // User who changed the status
  changedBy Int



  description String?



  createdAt DateTime @default(now())
  @@map("case_history")


}





// ==============================
// NEW: OFFICER INTERNAL NOTES
// ==============================


model CaseNote {


  id Int @id @default(autoincrement())



  caseId Int


  case Case
    @relation(
      fields:[caseId],
      references:[id],
      onDelete:Cascade
    )



  officerId Int


  officer User
    @relation(
      fields:[officerId],
      references:[id]
    )



  content String @db.Text



  createdAt DateTime @default(now())
  @@map("case_notes")


}