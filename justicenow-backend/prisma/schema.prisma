model TrackingCode {
  id     Int    @id @default(autoincrement())
  code   String @unique
  pin    String
  
  caseId Int    @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("tracking_codes")
}

model Evidence {
  id        Int      @id @default(autoincrement())
  fileUrl   String   
  fileType  String   
  
  // New UI Fields
  fileName  String?  
  fileSize  String?  
  
  caseId    Int
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  @@map("evidence_items")
}

model Message {
  id         Int      @id @default(autoincrement())
  content    String   @db.Text
  isFromUser Boolean  
  
  caseId     Int
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  
  officerId  Int?     
  officer    User?    @relation(fields: [officerId], references: [id])
  
  createdAt  DateTime @default(now())

  @@map("messages")
}